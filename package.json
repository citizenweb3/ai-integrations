{
  "name": "logos-chatbot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "smoke:retrieval": "TSX_DISABLE_IPC=1 DATABASE_URL=${DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} tsx scripts/retrieval-smoke.ts",
    "smoke:indexer": "DATABASE_URL=${INDEXER_SMOKE_DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} INDEXER_REQUIRE_LOCAL_DATABASE=1 yarn indexer:once && DATABASE_URL=${INDEXER_SMOKE_DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} yarn smoke:indexer:verify",
    "smoke:indexer:verify": "TSX_DISABLE_IPC=1 DATABASE_URL=${DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} tsx scripts/indexer-smoke.ts",
    "smoke:web-indexer": "DATABASE_URL=${WEB_INDEXER_SMOKE_DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} yarn smoke:web-indexer:seed-prune && DATABASE_URL=${WEB_INDEXER_SMOKE_DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} INDEXER_REQUIRE_LOCAL_DATABASE=1 INDEXER_ENABLE_STATIC_SOURCE=0 INDEXER_ENABLE_WEB_SOURCES=1 INDEXER_WEB_MAX_PAGES_PER_SOURCE=${INDEXER_WEB_MAX_PAGES_PER_SOURCE:-2} yarn indexer:once && DATABASE_URL=${WEB_INDEXER_SMOKE_DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} yarn smoke:web-indexer:verify",
    "smoke:web-indexer:seed-prune": "TSX_DISABLE_IPC=1 DATABASE_URL=${DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} tsx scripts/web-indexer-prune-seed.ts",
    "smoke:web-indexer:verify": "TSX_DISABLE_IPC=1 DATABASE_URL=${DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} tsx scripts/web-indexer-smoke.ts",
    "smoke:github-indexer": "DATABASE_URL=${GITHUB_INDEXER_SMOKE_DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} INDEXER_REQUIRE_LOCAL_DATABASE=1 INDEXER_ENABLE_STATIC_SOURCE=0 INDEXER_ENABLE_WEB_SOURCES=0 INDEXER_ENABLE_GITHUB_SOURCES=1 INDEXER_GITHUB_REPO_ALLOWLIST=${INDEXER_GITHUB_REPO_ALLOWLIST:-logos-co/logos-docs,logos-co/logos-lips,logos-blockchain/logos-blockchain-specs} INDEXER_GITHUB_MAX_FILES_PER_REPO=${INDEXER_GITHUB_MAX_FILES_PER_REPO:-2} yarn indexer:once && DATABASE_URL=${GITHUB_INDEXER_SMOKE_DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} INDEXER_GITHUB_REPO_ALLOWLIST=${INDEXER_GITHUB_REPO_ALLOWLIST:-logos-co/logos-docs,logos-co/logos-lips,logos-blockchain/logos-blockchain-specs} yarn smoke:github-indexer:verify",
    "smoke:github-indexer:verify": "TSX_DISABLE_IPC=1 DATABASE_URL=${DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} tsx scripts/github-indexer-smoke.ts",
    "smoke:chat-api": "TSX_DISABLE_IPC=1 CHAT_API_URL=${CHAT_API_URL:-http://127.0.0.1:3010/api/chat} tsx scripts/chat-api-smoke.ts",
    "audit:rag": "TSX_DISABLE_IPC=1 DATABASE_URL=${DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} CHAT_API_URL=${CHAT_API_URL:-http://127.0.0.1:3010/api/chat} tsx scripts/rag-audit.ts",
    "rag:wipe": "TSX_DISABLE_IPC=1 DATABASE_URL=${DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} tsx scripts/wipe-rag.ts",
    "rag:verify": "TSX_DISABLE_IPC=1 DATABASE_URL=${DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} tsx scripts/rag-verify.ts",
    "rag:warm-starter": "TSX_DISABLE_IPC=1 DATABASE_URL=${DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} REDIS_URL=${REDIS_URL:-redis://localhost:56379} tsx scripts/warm-starter-cache.ts",
    "indexer:start": "TSX_DISABLE_IPC=1 tsx indexer/index.ts",
    "indexer:once": "TSX_DISABLE_IPC=1 INDEXER_RUN_ONCE=1 INDEXER_ENABLE_STATIC_SOURCE=${INDEXER_ENABLE_STATIC_SOURCE:-1} INDEXER_MOCK_EMBEDDINGS=${INDEXER_MOCK_EMBEDDINGS:-1} DATABASE_URL=${DATABASE_URL:-postgresql://logos:logos@localhost:55433/logos_chatbot} tsx indexer/index.ts"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "4.0.128",
    "@ai-sdk/react": "3.0.179",
    "@mozilla/readability": "^0.6.0",
    "ai": "6.0.177",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "^5.7.3",
    "highlight.js": "^11.11.1",
    "ioredis": "5.10.1",
    "jsdom": "^29.1.1",
    "next": "16.2.6",
    "cron": "3.5.0",
    "postgres": "3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
