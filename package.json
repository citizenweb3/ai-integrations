{
  "name": "bizdev-email-agent",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=25.2.1",
    "yarn": ">=1.22.22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "sh -c 'yarn dev:dashboard & yarn dev:worker & wait'",
    "dev:dashboard": "yarn workspace @bizdev/dashboard dev",
    "dev:worker": "yarn workspace @bizdev/worker dev",
    "build": "yarn workspaces run build",
    "typecheck": "yarn workspaces run typecheck",
    "test": "yarn test:db && yarn test:worker",
    "test:db": "node --import tsx --test --test-concurrency=1 packages/*/test/**/*.test.ts",
    "test:worker": "node --import tsx --test apps/worker/test/**/*.test.ts",
    "verify": "yarn typecheck && yarn build && yarn check:security-overrides",
    "verify:db": "yarn db:migrate && yarn test:db",
    "check:security-overrides": "node scripts/check-security-overrides.mjs",
    "lint": "yarn workspace @bizdev/dashboard lint",
    "db:migrate": "yarn workspace @bizdev/db db:migrate",
    "db:reset": "yarn workspace @bizdev/db db:reset"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "eslint": "10.2.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "resolutions": {
    "postcss": "8.5.12"
  },
  "dependencies": {
    "pino": "^10.3.1"
  }
}
