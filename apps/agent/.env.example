GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
# `global` covers preview models (e.g. gemini-3-flash-preview) which are not
# served from regional endpoints. Set to a region (e.g. us-central1) only if
# every stage uses GA models.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
AGENT_PORT=8000
# Default for classify_reply / validate_claims — fast + cheap.
AGENT_DEFAULT_MODEL=gemini-3.5-flash
# Search-grounding stages must run on Gemini 2.x: ADK 1.33 google_search
# built-in tool is not wired through the gemini-3 function-call path.
AGENT_RESEARCH_SNAPSHOT_MODEL=gemini-2.5-flash
AGENT_RESEARCH_MORE_MODEL=gemini-2.5-flash
AGENT_CAMPAIGN_DISCOVERY_MODEL=gemini-2.5-flash
AGENT_RESEARCH_QUALITY_GATE_MODEL=gemini-3.5-flash
AGENT_VALIDATE_CLAIMS_MODEL=gemini-3.5-flash
AGENT_CLASSIFY_REPLY_MODEL=gemini-3.5-flash
# Drafting stages — Gemini 3.1 Pro preview for higher-quality reasoning on
# subject/body generation and AI revise. Verified in Vertex Model Garden on
# 2026-05-25.
AGENT_DRAFT_EMAIL_MODEL=gemini-3.1-pro-preview
AGENT_DRAFT_WARM_EMAIL_MODEL=gemini-3.1-pro-preview
AGENT_REVISE_EMAIL_MODEL=gemini-3.1-pro-preview
