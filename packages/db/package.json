{
  "name": "@bizdev/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node --import tsx src/migrate.ts",
    "db:reset": "node --import tsx src/reset.ts"
  },
  "dependencies": {
    "@bizdev/shared": "0.0.0",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  }
}
