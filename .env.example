DATABASE_URL=postgres://bizdev:bizdev@localhost:55432/bizdev
DASHBOARD_PORT=3000
RESEND_WEBHOOK_SECRET_DELIVERY=whsec_bG9jYWxfcmVzZW5kX2RlbGl2ZXJ5X3NlY3JldA==
RESEND_WEBHOOK_SECRET_INBOUND=whsec_bG9jYWxfcmVzZW5kX2luYm91bmRfc2VjcmV0
RESEND_API_KEY=
RESEND_FROM_EMAIL=outreach@example.com

WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEALTH_MAX_AGE_SECONDS=30
WORKER_POOLS=urgent,drafting,background,telegram

# Observability. Leave empty locally; when set, dashboard commands and worker
# jobs export OTLP traces to `${OTEL_EXPORTER_OTLP_ENDPOINT}/v1/traces`.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TIMEOUT_MS=250

# Agent (ADK / Vertex AI)
AGENT_BASE_URL=http://localhost:8000
# Default for classify_reply / validate_claims — fast + cheap.
AGENT_DEFAULT_MODEL=gemini-3.5-flash
# Search-grounding stages must run on Gemini 2.x: ADK 1.33 google_search
# built-in tool is not wired through the gemini-3 function-call path
# (model emits function_call("google_search") which has no user-tool match).
AGENT_RESEARCH_SNAPSHOT_MODEL=gemini-2.5-flash
AGENT_RESEARCH_MORE_MODEL=gemini-2.5-flash
AGENT_CAMPAIGN_DISCOVERY_MODEL=gemini-2.5-flash
AGENT_VALIDATE_CLAIMS_MODEL=gemini-3.5-flash
AGENT_CLASSIFY_REPLY_MODEL=gemini-3.5-flash
# Drafting stages — Gemini 3.1 Pro preview for higher-quality reasoning on
# subject/body and AI revise. Verified in Vertex Model Garden on 2026-05-25.
AGENT_DRAFT_EMAIL_MODEL=gemini-3.1-pro-preview
AGENT_DRAFT_WARM_EMAIL_MODEL=gemini-3.1-pro-preview
AGENT_REVISE_EMAIL_MODEL=gemini-3.1-pro-preview
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
# `global` covers preview models (for example gemini-3.1-pro-preview);
# switch to a region only if every stage uses GA models.
GOOGLE_CLOUD_LOCATION=global
# Path to a service-account JSON inside the container; for Compose set HOST_GCP_SA_JSON
# on the host. Cloud Run / GCE / GKE should rely on the metadata server / workload identity instead.
GOOGLE_APPLICATION_CREDENTIALS=
HOST_GCP_SA_JSON=

# RAG embeddings (worker-side)
RAG_EMBED_PROVIDER=stub
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
# gemini-embedding-001 supports 768/1536/3072. text-embedding-004 maxes at
# 768 and will 400 with the vector(1536) schema — do not switch back without
# also migrating the column type.
VERTEX_RAG_EMBED_MODEL=gemini-embedding-001
VERTEX_RAG_EMBED_DIMENSIONS=1536

# Telegram notifications (worker-side, secondary command channel).
# Leave empty to disable: the worker emits telegram_notification_skipped
# events for each enqueued notification job and completes them cleanly
# so retry budgets aren't burned in environments without a bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# From address used for `/approve` sends initiated via Telegram. Falls back to
# RESEND_FROM_EMAIL when unset; if both are empty the /approve branch refuses.
TELEGRAM_DEFAULT_FROM_EMAIL=
