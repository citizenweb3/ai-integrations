# Telegram user account (get from https://my.telegram.org/apps)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram session string (generate with: docker compose run --rm tg-growth-agent python scripts/generate-session.py)
TELEGRAM_SESSION=

# Telegram bot for approval UI (create via @BotFather)
TELEGRAM_BOT_TOKEN=
APPROVAL_CHAT_ID=

# ValidatorInfo RAG API
RAG_API_TOKEN=
RAG_API_URL=

# ValidatorInfo PostgreSQL
# IMPORTANT: use a READ-ONLY role (no INSERT/UPDATE/DELETE/DDL/EXECUTE grants).
# is_safe_select() is defence-in-depth only; the role is the real security boundary.
DATABASE_URL=

# Vertex AI (Gemini). Auth is ADC via a service-account JSON; NO GOOGLE_API_KEY.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./secrets/vertex-sa.json

# Ollama pre-filter API (fallback only; router_provider=ollama in config.yaml)
OLLAMA_TOKEN=
