# Database (password only — user/db hardcoded as logos/logos_chatbot)
POSTGRES_PASSWORD=logos

# Vertex AI (Google Cloud project ID; SA JSON must exist at ./secrets/vertex-sa.json)
GOOGLE_CLOUD_PROJECT=

# GitHub crawler (unauthenticated rate limit = 60/h, with token = 5000/h)
GITHUB_API_TOKEN=

# Dev opt-in: mock embeddings (skip Vertex calls, deterministic hash vectors)
# RETRIEVAL_MOCK_EMBEDDINGS=1
# INDEXER_MOCK_EMBEDDINGS=1
