# Database
DATABASE_URL=postgresql://logos:logos@postgres:5432/logos_chatbot
POSTGRES_USER=logos
POSTGRES_PASSWORD=logos
POSTGRES_DB=logos_chatbot

# Redis
REDIS_URL=redis://redis:6379

# Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
HOST_GCP_SA_JSON=
ANSWER_MODEL=gemini-3-flash-preview
REWRITE_MODEL=gemini-2.5-flash
RERANK_MODEL=gemini-2.5-flash
RERANK_ENABLED=0
EMBEDDING_MODEL=gemini-embedding-001
RETRIEVAL_MOCK_EMBEDDINGS=1

# App
PUBLIC_URL=http://localhost:3010
SERVER_PORT=3000
APP_HOST_PORT=3010
NODE_ENV=development

# Indexer
GITHUB_API_TOKEN=
INDEXER_ENABLE_STATIC_SOURCE=1
INDEXER_ENABLE_RAW_GITHUB_SOURCES=1
INDEXER_ENABLE_WEB_SOURCES=1
INDEXER_ENABLE_GITHUB_SOURCES=0
INDEXER_MOCK_EMBEDDINGS=1
INDEXER_STATIC_CRON=17 3 * * *
INDEXER_RAW_GITHUB_CRON=37 3 * * *
INDEXER_WEB_CRON=23 4 * * *
INDEXER_WEB_MAX_PAGES_PER_SOURCE=12
INDEXER_GITHUB_CRON=41 3 * * *
INDEXER_GITHUB_MAX_REPOS_PER_ORG=120
INDEXER_GITHUB_MAX_FILES_PER_REPO=60
INDEXER_GITHUB_MAX_FILE_BYTES=1000000
INDEXER_GITHUB_REPO_ALLOWLIST=
INDEXER_SHUTDOWN_GRACE_MS=25000
INDEXER_REQUIRE_LOCAL_DATABASE=0
INDEXER_SMOKE_DATABASE_URL=postgresql://logos:logos@localhost:55433/logos_chatbot
ALLOW_INDEXER_SMOKE_NON_LOCAL=0
WEB_INDEXER_SMOKE_DATABASE_URL=postgresql://logos:logos@localhost:55433/logos_chatbot
ALLOW_WEB_INDEXER_SMOKE_NON_LOCAL=0
GITHUB_INDEXER_SMOKE_DATABASE_URL=postgresql://logos:logos@localhost:55433/logos_chatbot
ALLOW_GITHUB_INDEXER_SMOKE_NON_LOCAL=0
CHAT_API_URL=http://127.0.0.1:3010/api/chat

# Security and quotas
IP_HASH_SALT=CHANGE_ME_RANDOM_64_CHARS
RAG_API_TOKEN=CHANGE_ME
DAILY_GEMINI_SPEND_USD_CAP=10
RATE_LIMIT_PER_IP_PER_MINUTE=20
